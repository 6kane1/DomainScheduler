// Resources of DomainScheduler.exe: the icon, the manifest (administrator, per-monitor DPI v2) and the embedded
// fonts (SIL OFL). Compiled by build.sh with -Iapp/res. Owner: app shell.
#include <winresrc.h>

1 ICON "app.ico"
CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "app.manifest"

INTER_REGULAR RCDATA "Fonts/Inter-Regular.ttf"
INTER_MEDIUM RCDATA "Fonts/Inter-Medium.ttf"
INTER_SEMIBOLD RCDATA "Fonts/Inter-SemiBold.ttf"
MONO_REGULAR RCDATA "Fonts/JetBrainsMono-Regular.ttf"
MONO_MEDIUM RCDATA "Fonts/JetBrainsMono-Medium.ttf"
MONO_SEMIBOLD RCDATA "Fonts/JetBrainsMono-SemiBold.ttf"

// File properties (Explorer, Get-Item .VersionInfo, Check-DomainOS.ps1). build.sh passes the version from
// core/Cargo.toml; a build without those defines gets 0.0.0.
#ifndef DOS_V1
#define DOS_V1 0
#define DOS_V2 0
#define DOS_V3 0
#define DOS_VERSION_STR "0.0.0"
#endif
VS_VERSION_INFO VERSIONINFO
FILEVERSION DOS_V1,DOS_V2,DOS_V3,0
PRODUCTVERSION DOS_V1,DOS_V2,DOS_V3,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE VFT2_UNKNOWN
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "Domain OS"
      VALUE "FileDescription", "Domain OS Toolbox"
      VALUE "FileVersion", DOS_VERSION_STR
      VALUE "InternalName", "DomainScheduler"
      VALUE "OriginalFilename", "DomainScheduler.exe"
      VALUE "ProductName", "Domain OS Toolbox"
      VALUE "ProductVersion", DOS_VERSION_STR
      VALUE "LegalCopyright", "Copyright (c) 2026 Domain OS"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
