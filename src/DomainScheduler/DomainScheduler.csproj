<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>DomainScheduler.App</RootNamespace>
    <AssemblyName>DomainScheduler</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>embedded</DebugType>
    <!-- No background GC thread: the program allocates little, a blocking gen-2 collection is rare and short. -->
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
    <!-- Program.Main runs first (NativeHome: where the native libraries are unpacked), then WPF. -->
    <StartupObject>DomainScheduler.App.Program</StartupObject>
    <!-- DOTNET_STARTUP_HOOKS is ignored: no assembly named in the user's environment is loaded into this elevated process. -->
    <StartupHookSupport>false</StartupHookSupport>
  </PropertyGroup>
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="app.ico" />
    <!-- HUD fonts (1.14.0), SIL Open Font License 1.1: JetBrains Mono 2.304 and Inter 4.1; the license texts go along. -->
    <Resource Include="Fonts\*.ttf" />
    <Resource Include="Fonts\*-OFL.txt" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\DomainScheduler.Lib\DomainScheduler.Lib.csproj" />
    <PackageReference Include="System.Management" Version="8.0.0" />
  </ItemGroup>
</Project>
