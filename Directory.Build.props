<Project>
  <PropertyGroup>
    <LangVersion>12.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <PlatformTarget>x64</PlatformTarget>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <InvariantGlobalization>false</InvariantGlobalization>
    <Version>1.15.0-test1.0</Version>
    <!-- The update channel built into this build: "stable" (from #downloads / the site) or "test" (from #test-builds). -->
    <UpdateChannel>test</UpdateChannel>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Company>DomainScheduler</Company>
    <Product>DomainScheduler</Product>
  </PropertyGroup>
</Project>
